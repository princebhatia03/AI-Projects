# Neo4j (docker compose)
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# Local telco churn CSVs (relative to project root)
DATASET_DIR=

OFFERS_PATH=
ARTIFACTS_DIR=
DIAGNOSIS_TOP_N=

# Chat LLM: azure | lmstudio
LLM_PROVIDER=

# Azure OpenAI (used when LLM_PROVIDER=azure)
# LiteLLM reads AZURE_API_KEY, AZURE_API_BASE, and AZURE_API_VERSION.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=

# LM Studio (used when LLM_PROVIDER=lmstudio) — no API key
# Host-only (http://127.0.0.1:1234) or OpenAI base (…/v1) both work.
# Model id must match the loaded model (e.g. qwen/qwen3-4b).
LMSTUDIO_BASE_URL=
LMSTUDIO_MODEL=

MIN_N=
SHARE_DELTA=
MEAN_RELATIVE=
